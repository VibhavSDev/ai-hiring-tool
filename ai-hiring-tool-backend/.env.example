# Copy this file to .env and set your own local or deployment values.

# Server
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ai_hiring_tool

# Authentication (replace these placeholders with strong, unique secrets)
JWT_SECRET=replace-with-a-strong-random-secret
ACCESS_TOKEN_SECRET=replace-with-a-strong-random-secret
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_SECRET=replace-with-a-different-strong-random-secret
REFRESH_TOKEN_EXPIRY=7d

# AI providers
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_PROVIDER=local
HF_API_KEY=your-huggingface-api-key
HF_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Redis (optional; the worker defaults to 127.0.0.1:6379)
REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
